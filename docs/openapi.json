  "components": {
    "schemas": {
      "Acceptance": {
        "properties": {
          "rationale": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Rationale"
          },
          "review_date": {
            "type": "string",
            "format": "date",
            "title": "Review Date"
          }
        },
        "type": "object",
        "required": [
          "rationale",
          "review_date"
        ],
        "title": "Acceptance"
      },
      "AssessmentUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "Not Assessed",
              "Not Applicable",
              "Compliant",
              "Partially Compliant",
              "Non-Compliant",
              "Pending Verification"
            ],
            "title": "Status"
          },
          "rationale": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 10,
            "title": "Rationale"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "rationale",
          "version"
        ],
        "title": "AssessmentUpdate"
      },
      "Body_upload_api_assessments__id__evidence_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "review_due": {
            "type": "string",
            "format": "date",
            "title": "Review Due"
          }
        },
        "type": "object",
        "required": [
          "file",
          "review_due"
        ],
        "title": "Body_upload_api_assessments__id__evidence_post"
      },
      "FindingInput": {
        "properties": {
          "assessment_id": {
            "type": "integer",
            "title": "Assessment Id"
          },
          "risk_id": {
            "type": "integer",
            "title": "Risk Id"
          },
          "title": {
            "type": "string",
            "maxLength": 240,
            "minLength": 5,
            "title": "Title"
          },
          "action": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 10,
            "title": "Action"
          },
          "owner_id": {
            "type": "integer",
            "title": "Owner Id"
          },
          "due": {
            "type": "string",
            "format": "date",
            "title": "Due"
          }
        },
        "type": "object",
        "required": [
          "assessment_id",
          "risk_id",
          "title",
          "action",
          "owner_id",
          "due"
        ],
        "title": "FindingInput"
      },
      "FindingTransition": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "In Progress",
              "Ready for Retest",
              "Closed"
            ],
            "title": "State"
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Rationale"
          }
        },
        "type": "object",
        "required": [
          "state",
          "rationale"
        ],
        "title": "FindingTransition"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "NewAssessment": {
        "properties": {
          "control_id": {
            "type": "integer",
            "title": "Control Id"
          },
          "asset_id": {
            "type": "integer",
            "title": "Asset Id"
          },
          "period": {
            "type": "string",
            "maxLength": 30,
            "minLength": 4,
            "title": "Period",
            "default": "2026-Q4"
          }
        },
        "type": "object",
        "required": [
          "control_id",
          "asset_id"
        ],
        "title": "NewAssessment"
      },
      "Review": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "return"
            ],
            "title": "Decision"
          },
          "rationale": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 10,
            "title": "Rationale"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "rationale"
        ],
        "title": "Review"
      },
      "RiskInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 240,
            "minLength": 5,
            "title": "Title"
          },
          "department": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Department"
          },
          "asset_id": {
            "type": "integer",
            "title": "Asset Id"
          },
          "inherent_likelihood": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Inherent Likelihood"
          },
          "inherent_impact": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Inherent Impact"
          },
          "residual_likelihood": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Residual Likelihood"
          },
          "residual_impact": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Residual Impact"
          },
          "inherent_rationale": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Inherent Rationale"
          },
          "control_effectiveness_rationale": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Control Effectiveness Rationale"
          },
          "residual_rationale": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Residual Rationale"
          },
          "treatment": {
            "type": "string",
            "enum": [
              "mitigate",
              "avoid",
              "transfer",
              "accept"
            ],
            "title": "Treatment"
          }
        },
        "type": "object",
        "required": [
          "title",
          "department",
          "asset_id",
          "inherent_likelihood",
          "inherent_impact",
          "residual_likelihood",
          "residual_impact",
          "inherent_rationale",
          "control_effectiveness_rationale",
          "residual_rationale",
          "treatment"
        ],
        "title": "RiskInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}